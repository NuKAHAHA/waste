# Copy to .env (it is git-ignored) and fill in.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me

# Repository the job builds.
REPO_URL=https://github.com/NuKAHAHA/waste.git
REPO_BRANCH=main

# Optional: only for PUSH_IMAGE=true. Use a Docker Hub access token, not your password.
DOCKERHUB_USER=
DOCKERHUB_TOKEN=
